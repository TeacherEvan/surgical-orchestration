{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobCard",
  "description": "Orchestrator state ledger. Serialized form of JobCard produced by serializeJobCard() in references/types.ts.",
  "type": "object",
  "required": ["planId", "overallStatus", "jobs", "completedHashes"],
  "unevaluatedProperties": false,
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for this build plan run, e.g. BUILD-1754380000000"
    },
    "overallStatus": {
      "type": "string",
      "enum": ["IN_PROGRESS", "PLAYWRIGHT_TESTING", "COMPLETED", "ESCALATED", "FAILED"]
    },
    "jobs": {
      "type": "object",
      "description": "Keyed by job id (JOB-001, JOB-002, ...). One entry per parent folder.",
      "additionalProperties": { "$ref": "#/$defs/folderJob" }
    },
    "completedHashes": {
      "type": "array",
      "description": "Registry of canonical debrief hashes already seen. A repeat escalates instead of looping.",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "folderJob": {
      "type": "object",
      "required": ["id", "parentFolder", "status", "attempts", "debriefHistory"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentFolder": {
          "type": "string",
          "minLength": 1,
          "description": "The single directory this job's subagents are locked to."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "WORKER_ACTIVE",
            "VERIFICATION_ACTIVE",
            "VERIFIED",
            "ESCALATED",
            "FAILED"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Verifier rejections or Worker failures so far. At MAX_REVISION_CYCLES the job escalates."
        },
        "assignedWorkerId": { "type": "string" },
        "assignedVerifierId": { "type": "string" },
        "lastVerifierFeedback": {
          "type": "string",
          "description": "Failure or rejection reason inlined into the next Worker prompt."
        },
        "debriefHistory": {
          "type": "array",
          "items": { "$ref": "#/$defs/debriefEntry" }
        }
      }
    },
    "debriefEntry": {
      "type": "object",
      "required": ["attempt", "agentRole", "debrief", "hash"],
      "unevaluatedProperties": false,
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "agentRole": {
          "type": "string",
          "description": "Any AgentRole in references/types.ts (7 values).",
          "enum": [
            "WORKER",
            "VERIFIER",
            "TEST_FIXER",
            "CODE_REVIEWER",
            "FRONTEND_REVIEWER",
            "BACKEND_REVIEWER",
            "COMPOSER"
          ]
        },
        "debrief": { "type": "string" },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Canonical hash computed at dispatch. Never recompute downstream."
        }
      }
    }
  }
}
