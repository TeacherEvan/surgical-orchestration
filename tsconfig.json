{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["references/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.ts"],
  "exclude": ["node_modules", "benchmarks/e2e.spec.ts"]
}
